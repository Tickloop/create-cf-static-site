  "description": "Scaffold a static site that deploys to a Cloudflare Worker (free tier), with PR previews and production CI/CD",
  "keywords": [
    "cloudflare",
    "workers",
    "static-site",
    "create",
    "scaffold"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tickloop/create-cf-static-site.git"
  },
  "homepage": "https://github.com/Tickloop/create-cf-static-site#readme",
  "bugs": {
    "url": "https://github.com/Tickloop/create-cf-static-site/issues"
  },
  "type": "module",
  "bin": {
    "create-cf-static-site": "bin/create.mjs"
  },
  "files": [
    "bin",
    "template",
    "!template/node_modules",
    "!template/dist",
