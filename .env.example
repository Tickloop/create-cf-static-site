# Copy to .env and fill in. `.env` is gitignored and loaded by the Makefile.
# Plain KEY=value only — no quotes, no `export`, no spaces around `=`
# (Make reads this file literally, so quotes would become part of the value).
# Where each value comes from: docs/HUMAN_SETUP.md

# Cloudflare dashboard → Workers & Pages → right sidebar "Account ID".
CLOUDFLARE_ACCOUNT_ID=

# Local "operator" API token used by OpenTofu and local wrangler commands.
# Needs the permissions listed in docs/HUMAN_SETUP.md (step 4). NOT the CI token.
CLOUDFLARE_API_TOKEN=

# Private R2 bucket that stores OpenTofu state. One per account; shared by all
# sites made from this template (each site uses its own key inside it).
TFSTATE_BUCKET=tfstate

# R2 S3-compatible keys scoped to Object Read & Write on TFSTATE_BUCKET only.
TFSTATE_R2_ACCESS_KEY_ID=
TFSTATE_R2_SECRET_ACCESS_KEY=

# R2 S3-compatible keys scoped to Object Read & Write on the media bucket only
# (bucket name = `make infra-output`, created by `make infra-apply`).
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=
