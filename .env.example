# Copy to .env and fill in. `.env` is gitignored and loaded by the Makefile.
# Plain KEY=value only — no quotes, no `export`, no spaces around `=`
# (Make reads this file literally, so quotes would become part of the value).
# Where each value comes from: docs/HUMAN_SETUP.md

# Cloudflare dashboard → Cmd/Ctrl+K → "Copy account ID".
CLOUDFLARE_ACCOUNT_ID=

# The API token from docs/HUMAN_SETUP.md, step 3. CI uses the same one.
CLOUDFLARE_API_TOKEN=
