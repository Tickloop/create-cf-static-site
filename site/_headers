# Cloudflare static-assets headers file: https://developers.cloudflare.com/workers/static-assets/headers/
# Limits: 100 rules, 2,000 characters per line. Not validated locally, so check a preview after editing.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Unhashed filenames, so keep browser caching short. If your generator emits
# content-hashed files (e.g. Astro's /_astro/*), give that path
# `Cache-Control: public, max-age=31536000, immutable` instead.
/assets/*
  Cache-Control: public, max-age=3600
