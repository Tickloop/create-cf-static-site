# Dependencies and build output
node_modules/
dist/

# Local secrets — never commit (copy from .env.example)
.env

# Heavy media lives in R2, not git (synced with `make media-sync`)
media/*
!media/.gitkeep

# cf Build Output (generated by `make build`) and preview result JSON
.cloudflare/

# Terraform working files (state itself lives in R2)
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/crash.log
infra/tfplan

# OS / editor noise
.DS_Store
